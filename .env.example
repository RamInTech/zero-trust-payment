# Razorpay TEST-MODE credentials only. Never commit the filled-in .env.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Groq — the LLM that acts as the shopping agent. Optional: without it the
# system falls back to a deterministic parser and makes no LLM calls at all.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional. Groq retires model ids periodically; override here if the default
# in zerotrust/intent.py stops being served.
# GROQ_MODEL=qwen/qwen3.8-27b

# Webhook signing secret, from Dashboard -> Settings -> Webhooks when you
# create the webhook. Separate from the API keys above and set independently:
# a deployment can legitimately have keys and no webhook.
#
# Leave it unset and the receiver REFUSES every delivery rather than trusting
# it — an unconfigured webhook is a closed door, not an open one.
RAZORPAY_WEBHOOK_SECRET=

# The one admin account allowed to edit a mandate (cap, allowlist, expiry,
# velocity, revoke). ADMIN_PASSWORD_HASH is a bcrypt hash, never the
# plaintext password. Generate one with:
#   uv run python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
#
# Leave both unset and `scripts/run_ui.py` generates a random password for
# that run only, printed once at startup -- it does NOT fall back to an
# unauthenticated admin.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Optional. Signs session tokens; if unset, a random one is generated per
# process (sessions just do not survive a restart, same as the in-memory
# stores everything else here uses).
ADMIN_SESSION_SECRET=
